{
	"name": "sneakers",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build sneakers-api && nest build sneakers-batch",
		"format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:dev:batch": "nest start sneakers-batch --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "NODE_ENV=production node dist/apps/sneakers-api/main",
		"start:prod:batch": "NODE_ENV=production node dist/apps/sneakers-batch/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./apps/sneakers-api/test/jest-e2e.json"
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"@nestjs/apollo": "^13.4.5",
		"@nestjs/axios": "^4.0.1",
		"@nestjs/common": "^11.2.3",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.2.3",
		"@nestjs/graphql": "^13.4.5",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/mongoose": "^11.0.4",
		"@nestjs/platform-express": "^11.2.3",
		"@nestjs/platform-socket.io": "^11.2.3",
		"@nestjs/platform-ws": "^11.2.3",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/websockets": "^11.2.3",
		"axios": "^1.7.2",
		"bcryptjs": "^2.4.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.0",
		"graphql": "^16.8.1",
		"graphql-upload-minimal": "^1.6.4",
		"moment": "^2.29.4",
		"mongoose": "^8.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"uuid": "^11.1.1",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.3",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.2",
		"@types/node": "^20.3.1",
		"@types/supertest": "^2.0.12",
		"@types/ws": "^8.5.10",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"jest": "^29.5.0",
		"prettier": "^3.0.0",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.3",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.1.3"
	},
	"overrides": {
		"ws": "^8.21.3",
		"lodash": "^4.18.1",
		"uuid": "^11.1.1",
		"qs": "^6.16.0",
		"tmp": "^0.2.7",
		"webpack": "^5.110.3",
		"glob@10": "^10.5.0",
		"minimatch@9": "^9.0.9",
		"picomatch@4": "^4.0.7",
		"ajv@8": "^8.20.0",
		"file-type@20": "^21.3.2",
		"body-parser@1": "^1.20.6",
		"multer": "^2.3.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"roots": [
			"<rootDir>/apps/"
		]
	}
}
